{
  "name": "Share YouTube Videos with AI Summaries on Discord",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "feedUrl": "https://www.youtube.com/feeds/videos.xml?channel_id=UC08Fah8EIryeOZRkjBRohcQ"
      },
      "id": "f3ac44b6-7ad9-4bfe-9126-0fea7c2245c3",
      "name": "YouTube Video Trigger",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "position": [
        -480,
        320
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/captions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "videoId",
              "value": "={{ $json.id.match(/(?:[^:]*:){2}\\s*(.*)/)[1] }}"
            },
            {
              "name": "part",
              "value": "snippet"
            }
          ]
        },
        "options": {}
      },
      "id": "e4e10e8c-d8eb-4e37-a1f8-f99e9d639be3",
      "name": "Retrieve Caption Data",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -272,
        320
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "url": "=https://www.googleapis.com/youtube/v3/captions/{{ $json.caption.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "options": {}
      },
      "id": "564befe0-34e6-418a-92f7-44f840fd442d",
      "name": "Download Captions",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        176,
        320
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "operation": "text",
        "destinationKey": "content",
        "options": {}
      },
      "id": "f73768bb-b20b-4be3-a700-7291081e993e",
      "name": "Caption File Conversion",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        400,
        320
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-3.5-turbo",
          "cachedResultName": "GPT-3.5-TURBO"
        },
        "messages": {
          "values": [
            {
              "content": "=Summarise this transcript into three bullet points to sum up what the video is about and why someone should watch it: {{ $json[\"content\"] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fa59aa20-8f32-416b-8e0f-ccbc9be61954",
      "name": "Caption Summary with ChatGPT",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        624,
        320
      ],
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=🌟 New Video Alert! 🌟\n\n**{{ $('YouTube Video Trigger').item.json[\"title\"] }}**\n\n*What’s it about?*\n\n{{ $json[\"message\"][\"content\"] }}\n\n[Watch NOW]({{ $('YouTube Video Trigger').item.json[\"link\"] }}) and remember to share your thoughts!",
        "options": {}
      },
      "id": "1e517aae-4b04-4fb9-804d-3d7ec08eca48",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.discord",
      "position": [
        960,
        320
      ],
      "typeVersion": 2,
      "webhookId": "025355f1-885a-423a-837c-ce4d9bb5fcc4"
    },
    {
      "parameters": {
        "assignments": {
